rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /produtos/{document=**} {
      allow read, write: if request.auth != null;
    }

    match /movimentacoes/{document=**} {
      allow read, write: if request.auth != null;
    }

    match /vendas/{document=**} {
      allow read, write: if request.auth != null;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
